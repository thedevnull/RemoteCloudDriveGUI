#!/usr/bin/env bash
# AppRun: garante python3 + tkinter (instalando conforme a distro) e abre a GUI.
HERE="$(dirname "$(readlink -f "${0}")")"
APP="$HERE/usr/share/rclone-gui/rclone_gui.py"

have() { command -v "$1" >/dev/null 2>&1; }
notify() {
    if have zenity; then zenity --error --no-markup --text="$1" 2>/dev/null
    elif have kdialog; then kdialog --error "$1"
    elif have notify-send; then notify-send "Rclone Setup" "$1"
    fi
    echo "$1" >&2
}

has_tk() { have python3 && python3 -c 'import tkinter' >/dev/null 2>&1; }

if ! has_tk; then
    if   have pacman;       then PKGS="pacman -S --needed --noconfirm python tk"
    elif have apt-get;      then PKGS="apt-get update && apt-get install -y python3 python3-tk"
    elif have dnf;          then PKGS="dnf install -y python3 python3-tkinter"
    elif have zypper;       then PKGS="zypper --non-interactive install python3 python3-tk"
    elif have apk;          then PKGS="apk add python3 py3-tkinter"
    elif have xbps-install; then PKGS="xbps-install -Sy python3 python3-tkinter"
    else
        notify "Instale python3 com tkinter (python3-tk) e abra novamente."
        exit 1
    fi
    if have pkexec; then
        pkexec sh -c "$PKGS" || { notify "Falha ao instalar python3-tk."; exit 1; }
    elif have sudo && [ -t 0 ]; then
        sudo sh -c "$PKGS" || exit 1
    else
        notify "Instale python3-tk manualmente (ou instale o polkit/pkexec) e abra novamente."
        exit 1
    fi
    has_tk || { notify "tkinter continua indisponível após a instalação."; exit 1; }
fi

exec python3 "$APP" "$@"
